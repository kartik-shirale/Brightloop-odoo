# Copy this file to apps/core/.env, then supply your own connection and email settings.
NODE_ENV=development
PORT=3001
DATABASE_URL=

# Redis runs in Docker; 6380 avoids the service already using 6379 on this machine.
REDIS_URL=redis://127.0.0.1:6380
CORS_ORIGIN=http://localhost:3000

# Generate each secret separately: node -p "require('crypto').randomBytes(48).toString('hex')"
JWT_ACCESS_SECRET=
OTP_HMAC_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DAILY_LIMIT=10

# EmailJS template variables: to_email, name, otp, expiry_minutes, purpose.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Optional: provide both to seed the default verified ADMIN on startup or via db:seed.
# Minimum admin password length: 8 characters. Public signup always creates CUSTOMER.
ADMIN_EMAIL=
ADMIN_PASSWORD=
