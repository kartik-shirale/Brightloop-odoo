{
  "name": "@odoo/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "contract:emit": "prisma contract emit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "db:seed": "tsx src/prisma/seed.ts",
    "test:redis": "node --import tsx --test src/config/redis.integration.ts",
    "db:migrate": "prisma db migrate",
    "db:verify": "prisma db verify",
    "migration:plan": "prisma migration plan",
    "migration:status": "prisma migration status"
  },
  "dependencies": {
    "@brightloop/shared": "workspace:*",
    "@prisma/orm-family-sql": "8.0.0-rc.22",
    "@prisma/orm-postgres": "^8.0.0-rc.22",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.9.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "prisma": "^8.0.0-rc.29",
    "rimraf": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
