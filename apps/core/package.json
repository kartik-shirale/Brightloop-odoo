  },
  "devDependencies": {
    "@prisma/cli-engine": "0.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "prisma": "^8.0.0-rc.29",
    "rimraf": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
